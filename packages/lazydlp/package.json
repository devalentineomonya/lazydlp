{
	"name": "lazydlp",
	"version": "0.0.13",
	"license": "MIT",
	"bin": "dist/app.js",
	"type": "module",
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "bun build ./source/app.tsx --target=node --external yoga-wasm-web --outfile=./dist/app.js",
		"dev": "tsc --watch",
		"test": "prettier --check . && tsc -p tsconfig.test.json && ava"
	},
	"files": [
		"dist",
		"assets",
		"README.md"
	],
	"dependencies": {
		"yoga-wasm-web": "~0.3.3"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^3.0.1",
		"@types/ink-text-input": "^2.0.5",
		"@types/open": "^6.2.1",
		"@types/react": "^18.0.32",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^5.2.0",
		"chalk": "^5.2.0",
		"ink": "^4.1.0",
		"ink-gradient": "^3.0.0",
		"ink-testing-library": "^3.0.0",
		"ink-text-input": "^5.0.1",
		"open": "^11.0.0",
		"prettier": "^3.9.6",
		"react": "^18.2.0",
		"tsx": "^4.20.6",
		"typescript": "^5.0.3",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"ava": {
		"extensions": {
			"ts": "module",
			"tsx": "module"
		},
		"nodeArguments": [
			"--import",
			"tsx"
		],
		"environmentVariables": {
			"LAZYDLP_SKIP_AUTO_CONFIGURE": "1"
		},
		"timeout": "60s"
	},
	"prettier": "@vdemedes/prettier-config"
}
